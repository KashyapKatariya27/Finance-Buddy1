# Environment Mode ('development' or 'production')
NODE_ENV=development

# Server Port and Host
PORT=5000
HOST=0.0.0.0

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Render PostgreSQL or local)
DATABASE_URL=postgresql://financebuddy:password@localhost:5432/financebuddy?schema=public

# JWT Authentication Secret Key
JWT_SECRET=finance-buddy-super-secret-jwt-key-change-in-production

# Session secret fallback
SESSION_SECRET=finance-buddy-session-secret

# Optional AI API Key for LLM financial coach (Groq LLaMA or OpenAI)
AI_API_KEY=
GROQ_API_KEY=
